{
  "name": "freegma",
  "version": "0.0.0",
  "private": true,
  "description": "로컬 UI/UX 디자인·프로토타이핑 툴 (Electron) — docs/design.md",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm lint && pnpm deps && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "deps": "depcruise $(ls -d packages apps 2>/dev/null) --config .dependency-cruiser.json",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.8.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
