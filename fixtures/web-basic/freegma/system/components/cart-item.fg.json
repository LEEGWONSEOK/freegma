    "a11y": "수량 −/+ 버튼에 «수량 줄이기/늘리기» 이름."
  },
  "code": {
    "import": "@/components/ui/cart-item",
    "name": "CartItem"
  },
  "tree": {
    "id": "n_cit000",
    "type": "frame",
    "name": "CartItem",
    "w": "fill",
    "layout": {
      "dir": "row",
      "gap": "{spacing.4}",
      "pad": "{spacing.4}",
      "align": "center"
    },
    "fill": "{color.surface}",
    "stroke": {
      "color": "{color.border}"
    },
    "radius": "{radius.md}",
    "children": [
      {
        "id": "n_cit001",
        "type": "image",
        "name": "image",
        "w": 72,
        "h": 72,
        "radius": "{radius.sm}",
        "src": "assets/img-lamp.png"
      },
      {
        "id": "n_cit002",
        "type": "text",
        "name": "title",
        "text": "상품",
        "textStyle": "{style.body}",
