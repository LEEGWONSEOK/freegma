      "type": "text",
      "required": true
    },
    "price": {
      "type": "text",
      "required": true
    },
    "qty": {
      "type": "number",
      "default": 1,
      "min": 1
    }
  },
  "usage": {
    "use": "장바구니·주문 목록의 한 줄. 수량 조절 포함.",
