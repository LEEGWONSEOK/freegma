{
  "id": "button",
  "name": "Button",
  "kind": "base",
  "props": {
    "label": {
      "type": "text",
      "required": true
    },
    "variant": {
      "type": "enum",
      "options": ["primary", "ghost", "inverse"],
      "default": "primary"
    },
    "size": {
      "type": "enum",
      "options": ["md", "sm"],
      "default": "md"
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "states": ["default", "pressed", "disabled"],
  "usage": {
    "use": "사용자가 하는 행동 하나. primary는 화면에서 가장 중요한 행동 1개에만, 나머지는 ghost.",
    "avoid": "단순 페이지 이동 링크로 쓰지 않는다. 라벨은 «확인»보다 «장바구니 담기»처럼 동사로.",
    "a11y": "높이 최소 44pt. 아이콘만 있으면 접근성 이름 필수.",
    "limits": {
      "perScreen": {
        "variant=primary": 1
      }
    }
  },
  "code": {
    "import": "@/components/button",
    "name": "Button",
    "props": {
      "variant": "$variant",
      "size": "$size",
      "disabled": "$disabled",
      "children": "$label"
    }
  },
  "tree": {
    "id": "n_btn000",
    "type": "frame",
    "name": "Button",
    "layout": {
      "dir": "row",
      "pad": ["{spacing.3}", "{spacing.5}"],
      "align": "center",
      "justify": "center"
    },
    "fill": "{color.primary}",
    "radius": "{radius.md}",
    "children": [
      {
        "id": "n_btn001",
        "type": "text",
        "name": "label",
        "text": "버튼",
        "textStyle": "{style.body}",
        "weight": 600,
        "color": "{color.on-primary}"
      }
    ]
  }
}
